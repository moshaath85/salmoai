{
    "title": "payment_gateway_settings",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Primary key, auto-increment"
        },
        "gateway_name": {
            "type": "string",
            "description": "Gateway identifier: moyasar, tabby, tamara, stripe"
        },
        "display_name": {
            "type": "string",
            "description": "Display name for the gateway"
        },
        "api_key_encrypted": {
            "type": "string",
            "description": "Encrypted API key"
        },
        "secret_key_encrypted": {
            "type": "string",
            "description": "Encrypted secret key"
        },
        "public_key_encrypted": {
            "type": "string",
            "description": "Encrypted public/publishable key"
        },
        "webhook_secret_encrypted": {
            "type": "string",
            "description": "Encrypted webhook secret"
        },
        "merchant_id": {
            "type": "string",
            "description": "Merchant ID"
        },
        "environment": {
            "type": "string",
            "description": "sandbox or production"
        },
        "is_active": {
            "type": "boolean",
            "description": "Whether gateway is enabled"
        },
        "is_default": {
            "type": "boolean",
            "description": "Whether this is the default gateway"
        },
        "supported_currencies": {
            "type": "string",
            "description": "JSON array of supported currencies"
        },
        "supported_countries": {
            "type": "string",
            "description": "JSON array of supported countries"
        },
        "payment_methods": {
            "type": "string",
            "description": "JSON array of payment methods like creditcard, mada, applepay"
        },
        "sort_order": {
            "type": "integer",
            "description": "Display order"
        },
        "last_test_at": {
            "type": "string",
            "description": "Last connection test timestamp"
        },
        "last_test_status": {
            "type": "string",
            "description": "Last test result: success, failed"
        },
        "last_successful_payment_at": {
            "type": "string",
            "description": "Last successful payment timestamp"
        },
        "connection_status": {
            "type": "string",
            "description": "Current status: connected, disconnected, error"
        },
        "settings_json": {
            "type": "string",
            "description": "Additional settings as JSON"
        }
    },
    "required": [
        "id",
        "gateway_name",
        "display_name"
    ]
}